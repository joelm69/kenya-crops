  <worksheets>
    <worksheet name='Avg Profit by Farm &amp; Acre'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1b1b1b'>Average profit per farm by crop and acre: Sorghum highest, Maize lowest</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Crops_Clean+ (Kenya_Crops_Analysis)' name='federated.0u6ny050ombc3q12xgjdy1vuzjbf' />
          </datasources>
          <datasource-dependencies datasource='federated.0u6ny050ombc3q12xgjdy1vuzjbf'>
            <column caption='Avg Profit Per Farm' datatype='real' default-format='n&quot;KES &quot;#,##0,,.00M;-&quot;KES &quot;#,##0,,.00M' name='[Calculation_0277623575957512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG( [Yield (Kg/Acre)] * [Market Price (KES/Kg)] * [Planted Area (Acres)] - [Cost of Production (KES)] )' />
            </column>
            <column datatype='real' name='[Cost of Production (KES)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Crop Type]' role='dimension' type='nominal' />
            <column datatype='real' name='[Market Price (KES/Kg)]' role='measure' type='quantitative' />
            <column datatype='real' name='[Planted Area (Acres)]' role='measure' type='quantitative' />
            <column datatype='real' name='[Yield (Kg/Acre)]' role='measure' type='quantitative' />
            <column-instance column='[Crop Type]' derivation='None' name='[none:Crop Type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0277623575957512]' derivation='User' name='[usr:Calculation_0277623575957512:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0u6ny050ombc3q12xgjdy1vuzjbf].[none:Crop Type:nk]'>
