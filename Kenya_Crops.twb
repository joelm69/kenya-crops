              <groupfilter function='member' level='[none:Crop Type:nk]' member='&quot;Maize&quot;' />
              <groupfilter function='member' level='[none:Crop Type:nk]' member='&quot;Potatoes&quot;' />
              <groupfilter function='member' level='[none:Crop Type:nk]' member='&quot;Rice&quot;' />
              <groupfilter function='member' level='[none:Crop Type:nk]' member='&quot;Sorghum&quot;' />
              <groupfilter function='member' level='[none:Crop Type:nk]' member='&quot;Tea&quot;' />
              <groupfilter function='member' level='[none:Crop Type:nk]' member='&quot;Tomatoes&quot;' />
              <groupfilter function='member' level='[none:Crop Type:nk]' member='&quot;Wheat&quot;' />
            </groupfilter>
