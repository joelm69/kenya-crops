      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_0108436468342784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit (KES)] / [Revenue (KES)]' />
      </column>
      <column caption='Margin Class' datatype='string' name='[Calculation_0108436478271489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_0108436468342784]) THEN &quot;Unknown&quot;&#10;ELSEIF [Calculation_0108436468342784] &gt; 0.2 THEN &quot;High&quot;&#10;ELSE &quot;Low&quot;&#10;END' />
      </column>
      <column caption='Revenue High Margin' datatype='real' name='[Calculation_0108436495429634]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM( IF [Revenue (KES)] &gt; 5000 AND [Calculation_0108436468342784] &gt; 0.2 THEN [Revenue (KES)] END )' />
      </column>
      <column caption='Revenue Class' datatype='string' name='[Calculation_0108436505956355]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Revenue (KES)]) THEN &quot;Unknown&quot;&#10;ELSEIF [Revenue (KES)] &gt;= 3000000 THEN &quot;High&quot;&#10;ELSEIF [Revenue (KES)] &gt;=  1000000 THEN &quot;Medium&quot;&#10;ELSE &quot;Low&quot;&#10;END' />
      </column>
      <column caption='Margin OK' datatype='boolean' name='[Calculation_0108436509986820]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Revenue (KES)] &gt; 5000 OR [Calculation_0108436468342784] &gt; 0.2' />
      </column>
      <column caption='Region Label' datatype='string' name='[Calculation_0108436510724101]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Region]&#10;WHEN &quot;West&quot; THEN &quot;Western Region&quot;&#10;WHEN &quot;East&quot; THEN &quot;Eastern Region&quot;&#10;WHEN &quot;Central&quot; THEN &quot;Central Region&quot;&#10;ELSE &quot;Unknown Region&quot;&#10;END' />
      </column>
      <column caption='Revenue per Kg' datatype='real' name='[Calculation_0108436525985798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue (KES)]) / SUM( IF NOT ISNULL([Revenue (KES)]) THEN [Total Yield (Kg)] END )' />
      </column>
      <column caption='Total Revenue ' datatype='real' name='[Calculation_0277623543791616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue (KES)])' />
      </column>
      <column caption='Total Fertilizer Cost' datatype='real' name='[Calculation_0277623557189635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Yield (Kg)] * [Parameters].[Parameter 0277623553105922])' />
      </column>
      <column caption='Avg Market Price' datatype='real' name='[Calculation_0277623562899462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Market Price (KES/Kg)]) / COUNT([Market Price (KES/Kg)])' />
      </column>
      <column caption='Avg Weighted Price' datatype='real' name='[Calculation_0277623566565383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF NOT ISNULL([Revenue (KES)]) AND NOT ISNULL([Total Yield (Kg)]) THEN [Revenue (KES)] END )&#10;/&#10;SUM( IF NOT ISNULL([Revenue (KES)]) AND NOT ISNULL([Total Yield (Kg)]) THEN [Total Yield (Kg)] END )' />
      </column>
      <column caption='Avg Profit Per Farm' datatype='real' default-format='n&quot;KES &quot;#,##0,,.00M;-&quot;KES &quot;#,##0,,.00M' name='[Calculation_0277623575957512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( [Yield (Kg/Acre)] * [Market Price (KES/Kg)] * [Planted Area (Acres)] - [Cost of Production (KES)] )' />
      </column>
      <column caption='Avg Profit Per Acre' datatype='real' default-format='n&quot;KES &quot;#,##0,.00K;-&quot;KES &quot;#,##0,.00K' name='[Calculation_0277623582728201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit (KES)]) / SUM(IF NOT ISNULL([Profit (KES)]) THEN [Planted Area (Acres)] END)' />
      </column>
      <column caption='Median Yield per Acre' datatype='real' name='[Calculation_0277623602438154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([Yield (Kg/Acre)])' />
      </column>
      <column caption='Median Total Yield' datatype='real' name='[Calculation_0277623602634763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([Total Yield (Kg)])' />
      </column>
      <column caption='Revenue Above 5000' datatype='real' name='[Calculation_0277623608582156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Revenue (KES)] &gt; 5000 THEN [Revenue (KES)] END )' />
      </column>
      <column caption='Revenue West' datatype='real' name='[Calculation_0277623609872398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Region] = &quot;West&quot; THEN [Revenue (KES)] END )' />
      </column>
      <column caption='Crop Title' datatype='string' name='[Calculation_0277623614283792]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Crop Type]) = 1&#10;THEN ATTR([Crop Type]) + &quot; – Revenue&quot;&#10;ELSE &quot;All selected crops – Revenue&quot;&#10;END' />
      </column>
      <column caption='Fixed Revenue All' datatype='real' name='[Calculation_0277623617843217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Revenue (KES)]) }' />
      </column>
      <column caption='% of Total Revenue' datatype='real' default-format='p0.00%' name='[Calculation_0277623619829778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue (KES)]) / SUM([Calculation_0277623617843217])' />
      </column>
      <column caption='Revenue Region Fixed' datatype='real' name='[Calculation_0277623622082579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED[Region]:SUM([Revenue (KES)]) }' />
      </column>
      <column caption='Fixed Crop Type' datatype='real' name='[Calculation_0277623630491668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Crop Type] : SUM([Revenue (KES)]) }' />
      </column>
      <column caption='Revenue Ignore Region' datatype='real' name='[Calculation_0277623631069205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Revenue (KES)]) }' />
      </column>
